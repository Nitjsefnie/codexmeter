[MASTER]

# orjson is a C extension. Without this, pylint refuses to load it for
# introspection and reports every orjson.loads / orjson.JSONDecodeError as
# no-member — a false positive, both attributes exist. Allowing the load
# makes the check MORE accurate, not less: pylint verifies the real module
# instead of guessing. Nothing here disables or skips any message.
extension-pkg-allow-list=orjson

[MESSAGES CONTROL]
disable=
    line-too-long,
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,
    unused-argument,
    arguments-differ,
    import-error,
    invalid-name,
    no-name-in-module,
    broad-exception-caught,
    broad-exception-raised,
    global-statement,
    too-few-public-methods
max-attributes=30
max-args=10
max-positional-arguments=10
min-similarity-lines=15
